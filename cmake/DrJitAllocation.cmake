# Keep the vendored Dr.Jit checkout unchanged. Source builds compile a generated
# allocator translation unit with smaller bins for large CUDA device buffers.
if (SKBUILD)
  return()
endif()

option(MI_CUDA_COMPACT_ALLOCATIONS
  "Round CUDA device allocations >= 16 MiB to 2 MiB bins instead of powers of two" ON)

if (NOT MI_CUDA_COMPACT_ALLOCATIONS OR NOT TARGET drjit-core)
  return()
endif()

function(mi_configure_compact_drjit_allocations)
  get_target_property(drjit_source_dir drjit-core SOURCE_DIR)
  get_target_property(drjit_binary_dir drjit-core BINARY_DIR)
  set(original "${drjit_source_dir}/src/malloc.cpp")
  if (NOT EXISTS "${original}")
    message(FATAL_ERROR "MI_CUDA_COMPACT_ALLOCATIONS: Dr.Jit allocator source is missing: ${original}")
  endif()
  file(READ "${original}" source)

  # Fail on upstream changes instead of silently compiling an ineffective or
  # over-broad patch. Keep the public round_pow2() functions unchanged.
  set(anchor "size = round_pow2(size);")
  string(FIND "${source}" "${anchor}" first)
  if (first EQUAL -1)
    message(FATAL_ERROR "MI_CUDA_COMPACT_ALLOCATIONS: expected exactly one '${anchor}' in ${original}; review the upstream allocator")
  endif()
  string(LENGTH "${anchor}" anchor_length)
  math(EXPR after_anchor "${first} + ${anchor_length}")
  string(SUBSTRING "${source}" ${after_anchor} -1 remainder)
  string(FIND "${remainder}" "${anchor}" second)
  if (NOT second EQUAL -1)
    message(FATAL_ERROR "MI_CUDA_COMPACT_ALLOCATIONS: expected exactly one '${anchor}' in ${original}; found multiple matches")
  endif()
  set(replacement [=[// Large device arrays keep 2 MiB bins; host/shared/small allocations
    // retain upstream's power-of-two reuse policy.
    if (backend == JitBackend::CUDA && !shared && size >= size_t(16) * 1024 * 1024) {
        constexpr size_t quantum = size_t(2) * 1024 * 1024;
        if (size > size_t(-1) - (quantum - 1))
            jitc_raise("jit_malloc(): allocation size overflow.");
        size = (size + quantum - 1) / quantum * quantum;
    } else {
        size = round_pow2(size);
    }]=])
  string(REPLACE "${anchor}" "${replacement}" patched "${source}")

  # The generated translation unit lives outside src/. Resolve only its quoted
  # includes; adding src/ to the target search path would let private headers
  # such as string.h and malloc.h shadow standard library headers elsewhere.
  string(REGEX MATCHALL "#[ \t]*include[ \t]+\"[^\"\r\n]+\"" local_includes "${patched}")
  foreach(local_include IN LISTS local_includes)
    string(REGEX REPLACE "^#[ \t]*include[ \t]+\"([^\"]+)\"$" "\\1" header "${local_include}")
    get_filename_component(header_path "${header}" ABSOLUTE BASE_DIR "${drjit_source_dir}/src")
    if (NOT EXISTS "${header_path}")
      message(FATAL_ERROR "MI_CUDA_COMPACT_ALLOCATIONS: allocator header is missing: ${header_path}")
    endif()
    string(REPLACE "\"${header}\"" "\"${header_path}\"" absolute_include "${local_include}")
    string(REPLACE "${local_include}" "${absolute_include}" patched "${patched}")
  endforeach()

  set(generated "${drjit_binary_dir}/generated/malloc.cpp")
  get_target_property(sources drjit-core SOURCES)
  set(replaced 0)
  set(updated_sources)
  foreach(item IN LISTS sources)
    get_filename_component(absolute "${item}" ABSOLUTE BASE_DIR "${drjit_source_dir}")
    if (absolute STREQUAL original)
      list(APPEND updated_sources "${generated}")
      math(EXPR replaced "${replaced} + 1")
    else()
      list(APPEND updated_sources "${item}")
    endif()
  endforeach()
  if (NOT replaced EQUAL 1)
    message(FATAL_ERROR "MI_CUDA_COMPACT_ALLOCATIONS: expected exactly one malloc.cpp in drjit-core SOURCES; found ${replaced}")
  endif()

  # Only rewrite changed content, so ordinary reconfiguration does not rebuild
  # drjit-core. Track upstream changes even when CMakeLists.txt is unchanged.
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${original}")
  set(patched "// Generated by Mitsuba cmake/DrJitAllocation.cmake; do not edit.\n${patched}")
  set(previous "")
  if (EXISTS "${generated}")
    file(READ "${generated}" previous)
  endif()
  if (NOT previous STREQUAL patched)
    file(MAKE_DIRECTORY "${drjit_binary_dir}/generated")
    file(WRITE "${generated}" "${patched}")
  endif()
  set_property(TARGET drjit-core PROPERTY SOURCES "${updated_sources}")
  message(STATUS "Mitsuba: compact CUDA allocation bins enabled (>=16 MiB, 2 MiB bins)")
endfunction()

mi_configure_compact_drjit_allocations()
